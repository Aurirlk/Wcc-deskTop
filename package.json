{
  "name": "wcc-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Warcraft Campaign Craft — desktop AI harness for WC3 campaigns",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @wcc/desktop",
    "build:desktop": "npm run build -w @wcc/desktop",
    "check": "node packages/wcc-lua-check/src/cli.js examples/demo-campaign/src wcc-lib",
    "test:harness": "node --test harness/test/harness.test.js",
    "test": "npm run test -w @wcc/sidecar && npm run test -w @wcc/lua-check && npm run test -w @wcc/shared && npm run test:harness",
    "sidecar": "node packages/wcc-sidecar/src/server.js",
    "sync": "node scripts/sync-remotes.mjs",
    "sync:check": "node scripts/sync-remotes.mjs --check-only",
    "postinstall": "node scripts/optional-electron.js"
  },
  "engines": {
    "node": ">=20"
  }
}
